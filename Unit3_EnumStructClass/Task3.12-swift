class Vehicle {
    func description() {
        print("This is a vehicle")
    }
}

class Car: Vehicle {
    override func description() {
        print("This is a car")
    }
}

class Bike: Vehicle {
    override func description() {
        print("This is a bike")
    }
}

let vehicles: [Vehicle] = [Car(), Bike()]

for v in vehicles {
    v.description()
}

Output:
This is a car
This is a bike
