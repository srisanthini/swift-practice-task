struct BankAccount {
    var balance: Double

    mutating func deposit(_ amount: Double) {
        balance += amount
    }

    mutating func withdraw(_ amount: Double) {
        if amount <= balance {
            balance -= amount
        }
    }
}

var account = BankAccount(balance: 1000)
account.deposit(500)
account.withdraw(200)
print(account.balance)

Output:
1300.0
