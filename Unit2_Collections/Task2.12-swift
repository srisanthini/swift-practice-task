let a: Set<Int> = [1, 2, 3, 4]
let b: Set<Int> = [3, 4, 5, 6]

print("Union:", a.union(b))
print("Intersection:", a.intersection(b))
print("Subtracting:", a.subtracting(b))
print("Symmetric Difference:", a.symmetricDifference(b))

Output (set order may vary):
Union: [1, 2, 3, 4, 5, 6]
Intersection: [3, 4]
Subtracting: [1, 2]
Symmetric Difference: [1, 2, 5, 6]
